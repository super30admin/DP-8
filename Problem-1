// Time Complexity: O(n)
// Space Complexity: O(1)

// Iterate through the array and check if the difference between the previous 2 elements are the same as difference between the current and the previous number
// If yes add count to result
// Return result

class Solution {
    public int numberOfArithmeticSlices(int[] nums) {
        int result = 0;
        int n = nums.length;
        int value = 0;
        for(int i = 2; i < n; i++) {
            // Check condition
            if(nums[i] - nums[i-1] == nums[i-1] - nums[i-2])
                value = value + 1;
            else
                value = 0;
            
            result += value;
        }
        return result;
    }
}